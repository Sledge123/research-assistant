FROM node:22-bookworm-slim AS frontend
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --cache /app/.cache/npm
COPY web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/app/.cache \
    TEMP=/app/.cache/tmp TMP=/app/.cache/tmp TMPDIR=/app/.cache/tmp
WORKDIR /app
COPY requirements-web.txt ./
RUN mkdir -p .cache/tmp output/web output/literature output/research-library output/abtem output/pymatgen \
    && python -m venv .venv \
    && .venv/bin/pip install --no-cache-dir -r requirements-web.txt \
    && useradd --uid 10001 --no-create-home appuser \
    && chown -R 10001:10001 /app
COPY --chown=10001:10001 highscore_web ./highscore_web
COPY --chown=10001:10001 highscore_database ./highscore_database
COPY --chown=10001:10001 highscore_worker ./highscore_worker
COPY --chown=10001:10001 highscore_downloader ./highscore_downloader
COPY --chown=10001:10001 highscore_literature ./highscore_literature
COPY --chown=10001:10001 highscore_abtem ./highscore_abtem
COPY --chown=10001:10001 highscore_pymatgen ./highscore_pymatgen
COPY --chown=10001:10001 highscore_crystal ./highscore_crystal
COPY --chown=10001:10001 highscore_science ./highscore_science
COPY --chown=10001:10001 deploy/container-entrypoint.py ./deploy/container-entrypoint.py
COPY --from=frontend --chown=10001:10001 /app/web/dist ./web/dist
USER 10001:10001
EXPOSE 8787
ENTRYPOINT ["python", "-B", "./deploy/container-entrypoint.py"]
CMD [".venv/bin/python", "-B", "-m", "highscore_web", "serve", "--root", ".", "--host", "0.0.0.0", "--port", "8787"]
