FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/app/.cache \
    TEMP=/app/.cache/tmp TMP=/app/.cache/tmp TMPDIR=/app/.cache/tmp
WORKDIR /app
COPY requirements-web.txt ./
RUN mkdir -p .cache/tmp output runtime data/private-databases \
    && python -m venv .venv \
    && .venv/bin/pip install --no-cache-dir -r requirements-web.txt \
    && useradd --uid 10001 --no-create-home appuser \
    && chown -R 10001:10001 /app
COPY --chown=10001:10001 highscore_database ./highscore_database
COPY --chown=10001:10001 highscore_worker ./highscore_worker
COPY --chown=10001:10001 highscore_downloader ./highscore_downloader
COPY --chown=10001:10001 highscore_literature ./highscore_literature
COPY --chown=10001:10001 deploy/container-entrypoint.py ./deploy/container-entrypoint.py
USER 10001:10001
ENTRYPOINT ["python", "-B", "./deploy/container-entrypoint.py"]
CMD [".venv/bin/python", "-B", "-m", "highscore_database", "--config", "database-worker.local.json", "--check-config"]
